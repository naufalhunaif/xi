            </div>
            <div class="wa-inbox-heading">
              <strong>Chat</strong>
              <div id="inboxChannels" class="wa-inbox-channels" role="group" aria-label="Saluran" data-i18n-aria-label="Saluran" hidden>
                <button type="button" data-channel="all" aria-pressed="true" aria-label="Semua saluran" title="Semua saluran" data-i18n-aria-label="Semua saluran" data-i18n-title="Semua saluran"><svg class="wa-ico" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M4 13l2-8h12l2 8v6H4zM4 13h5l1 2h4l1-2h5" /></svg></button>
                <button type="button" data-channel="wa" aria-pressed="false" aria-label="WhatsApp" title="WhatsApp"><svg class="wa-ico" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M4.5 19.5l1.2-3.6A8 8 0 1 1 8.3 18.4z" /></svg></button>
                <button type="button" data-channel="ig" aria-pressed="false" aria-label="Instagram" title="Instagram"><svg class="wa-ico" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M8.5 4h7A4.5 4.5 0 0 1 20 8.5v7a4.5 4.5 0 0 1-4.5 4.5h-7A4.5 4.5 0 0 1 4 15.5v-7A4.5 4.5 0 0 1 8.5 4zM12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" /></svg></button>
              </div>
              <a id="connectHint" class="wa-connect-hint" href="{{ appUrl }}/settings#numbers" hidden data-i18n="Hubungkan nomor">Hubungkan nomor</a>
              <button id="inboxSelect" type="button" class="wa-icon-button wa-inbox-select" aria-pressed="false" aria-label="Pilih chat" title="Pilih chat" data-i18n-aria-label="Pilih chat" data-i18n-title="Pilih chat">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7l2 2 4-4M4 17l2 2 4-4M13 7h7M13 17h7"/></svg>
              </button>
            </div>
            <div id="inboxBulk" class="wa-inbox-bulk" role="toolbar" aria-label="Chat terpilih" data-i18n-aria-label="Chat terpilih" hidden>
              <button id="inboxBulkAll" type="button" class="wa-inbox-bulk-all" aria-pressed="false" title="Pilih semua" data-i18n-title="Pilih semua" aria-label="Pilih semua" data-i18n-aria-label="Pilih semua" data-i18n="Semua">Semua</button>
              <span id="inboxBulkCount" class="wa-inbox-bulk-count"></span>
              <button id="inboxBulkRead" type="button" class="button small" data-i18n="Tandai dibaca">Tandai dibaca</button>
              <button id="inboxBulkUnread" type="button" class="button small" data-i18n="Tandai belum dibaca">Tandai belum dibaca</button>
              <button id="inboxBulkCancel" type="button" class="wa-icon-button" aria-label="Batal" title="Batal" data-i18n-aria-label="Batal" data-i18n-title="Batal">×</button>
            </div>

            <div class="wa-inbox-search">
              <input id="inboxSearch" type="search" autocomplete="off" spellcheck="false"
                placeholder="Cari nama, nomor, atau isi chat" aria-label="Cari nama, nomor, atau isi chat"
                data-i18n-placeholder="Cari nama, nomor, atau isi chat" data-i18n-aria-label="Cari nama, nomor, atau isi chat" />
            </div>
            <div id="inboxFilters" class="wa-inbox-filters" role="group" aria-label="Filter percakapan" data-i18n-aria-label="Filter percakapan">
              <div class="wa-inbox-tabs">
                @each(tab in
                [
                  { key: 'all', label: 'Semua' },
                  { key: 'unanswered', label: 'Belum dibalas' },
                  { key: 'cs', label: 'Perlu CS' },
                  { key: 'payment', label: 'Pembayaran' },
                  { key: 'order', label: 'Order' },
                  { key: 'done', label: 'Selesai' },
                ])
                  <button
                    type="button"
                    data-inbox-filter="{{ tab.key }}"
                    aria-pressed="{{ tab.key === 'all' ? 'true' : 'false' }}"
                   data-i18n-auto>
                    {{ tab.label }}
                    <span data-filter-count></span>
                  </button>
                @end
                <span class="wa-inbox-fade" aria-hidden="true"></span>
              </div>
              <button id="inboxFiltersMore" class="wa-inbox-more" type="button" aria-expanded="false" aria-label="Tampilkan semua filter" title="Tampilkan semua filter" data-i18n-aria-label="Tampilkan semua filter" data-i18n-title="Tampilkan semua filter" hidden>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </button>
            </div>

            <div id="contacts" class="wa-contacts" data-selected-jid="{{ selectedJid }}" data-selected-line="{{ selectedLine || 1 }}">
              @each(contact in contacts)
                <a
                  class="wa-contact {{ contact.jid === selectedJid && (contact.line_id || 1) === (selectedLine || 1) ? 'active' : '' }} {{ contact.ai_running ? 'ai-running' : '' }}"
                  href="{{ appUrl }}/?jid={{ contact.jid }}{{ contact.line_id > 1 ? '&line=' + contact.line_id : '' }}"
                  data-jid="{{ contact.jid }}"
                  data-mode="{{ contact.handling_mode }}"
                  data-payment="{{ contact.needs_payment ? 'true' : 'false' }}"
                  data-order="{{ contact.has_order ? 'true' : 'false' }}"
                  data-done="{{ contact.done_order ? 'true' : 'false' }}"
                  data-unanswered="{{ contact.unanswered_count }}"
                  data-line="{{ contact.line_id || 1 }}"
                >
                  @if(contact.profile_picture_url)
                    <img
                      class="wa-contact-avatar"
                      src="{{ contact.profile_picture_url }}"
                      alt=""
                      loading="lazy"
                    />
                  @else
                    <span class="wa-contact-avatar">
                      {{
                        (contact.contact_name || contact.jid)
                          .slice(0, 1)
                          .toUpperCase()
                      }}
                    </span>
                  @end

                  <span class="wa-contact-content">
                    <strong>
                      {{ contact.contact_name || (contact.jid.endsWith('@lid') ? 'Tanpa nama' : '+' + contact.jid.split('@')[0]) }}
                      @if(contact.line_sim)
                        <span class="wa-sim" title="{{ contact.line_label || '' }}" aria-label="SIM {{ contact.line_sim }}">{{ contact.line_sim }}</span>
                      @end
                    </strong>
                    <small class="{{ contact.activity ? 'active' : '' }}">
                      {{ contact.activity || String(contact.body || '').replace(/^\[Komentar di postingan[^\]]*\]\s*/, '💬 ') }}
                    </small>
                  </span>
                  <span class="wa-contact-meta">
                    @if(contact.unanswered_count > 0)
                      <span
                        class="wa-contact-pending"
                        title="{{ contact.unanswered_count }} unanswered"
                        aria-label="{{ contact.unanswered_count }} unanswered"
                      >
                        {{ contact.unanswered_count }}
                        ↩
                      </span>
                    @end
                    @if(contact.unread_count > 0)
                      <span
                        class="wa-unread-count"
                        aria-label="{{ contact.unread_count }} unread"
                      >
                        {{ contact.unread_count }}
                      </span>
                    @end

                    @if(contact.needs_payment)
                      <span class="wa-contact-coin" title="Pembayaran perlu dikonfirmasi" aria-label="Pembayaran perlu dikonfirmasi" data-i18n-title="Pembayaran perlu dikonfirmasi" data-i18n-aria-label="Pembayaran perlu dikonfirmasi"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M14.5 9.2c-.5-.8-1.5-1.2-2.5-1.2-1.4 0-2.5.8-2.5 1.9 0 2.6 5 1.4 5 4.1 0 1.1-1.1 2-2.5 2-1.1 0-2.1-.5-2.6-1.3M12 6.5V8m0 8v1.5"/></svg></span>
                    @end
                    @if(Number(contact.priority) >= 4 && (contact.unanswered_count > 0 || contact.handling_mode === 'cs'))
                      <span class="wa-contact-mode urgent" title="Prioritas chat di kotak masuk" data-i18n="Penting" data-i18n-title="Prioritas chat di kotak masuk">Penting</span>
                    @end
                    @if(contact.role === 'vendor' || contact.role === 'lainnya')
                      <span class="wa-contact-mode role" title="{{ contact.role === 'vendor' ? 'Vendor / supplier bahan — bukan pelanggan' : 'Bukan pelanggan' }}">{{ contact.role === 'vendor' ? 'Vendor' : 'Lainnya' }}</span>
                    @elseif(contact.handling_mode === 'cs')
                      <span class="wa-contact-mode cs">CS</span>
                    @end
                  </span>
                </a>
              @else
                <div class="wa-empty" data-i18n="Belum ada kontak">Belum ada kontak</div>
              @end
            </div>
          </aside>

          <section id="chat" class="wa-panel wa-chat-panel">
            <div class="wa-panel-title wa-room-title">
              <a
                id="roomBack"
                class="wa-room-back"
