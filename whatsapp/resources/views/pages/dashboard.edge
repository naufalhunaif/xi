                data-i18n-title="Kembali ke daftar chat"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M15 18l-6-6 6-6" />
                </svg>
              </a>
              @if(selectedContact)
                @if(selectedContact.profile_picture_url)
                  <img
                    id="roomAvatar"
                    class="wa-room-avatar"
                    src="{{ selectedContact.profile_picture_url }}"
                    alt=""
                  />
                @else
                  <span id="roomAvatar" class="wa-room-avatar">
                    {{
                      (selectedContact.contact_name || selectedJid)
                        .slice(0, 1)
                        .toUpperCase()
                    }}
                  </span>
                @end
              @end

              <div class="wa-room-identity">
                <strong id="roomName">
                  {{
                    selectedContact
                      ? selectedContact.contact_name || (selectedJid.endsWith('@lid') ? 'Tanpa nama' : '+' + selectedJid.split('@')[0])
                      : 'Chat'
                  }}
                </strong>
                <div id="roomStatus" class="wa-room-status" {{ selectedContact ? '' : 'hidden' }}>
                  <button id="roomMode" type="button" class="wa-room-mode {{ selectedContact?.handling_mode }}" data-i18n-auto
                    aria-expanded="false" aria-controls="roomHandlingDetails"
                    data-reason="{{ selectedContact?.handoff_reason || '' }}"
                    data-schedule-paused="{{ selectedContact?.schedule_paused ? 'true' : 'false' }}"
                    data-note="{{ selectedContact?.handling_note || '' }}"
                    data-waiting="{{ selectedContact?.goal_waiting_for || '' }}"
                    data-next="{{ selectedContact?.goal_next_action || '' }}">
                    {{ selectedContact?.ai_excluded ? 'Tanpa AI' : selectedContact?.handling_mode === 'cs' ? 'Ditangani CS' : 'Ditangani AI' }}
                  </button>
                  <small id="roomGoalStatus" class="wa-muted" aria-live="polite"></small>
                </div>
              </div>
              <div
                id="roomHandling"
                class="wa-room-handling"
                role="group"
                aria-label="Tindakan percakapan"
                data-mode="{{ selectedContact ? selectedContact.handling_mode : 'ai' }}"
                {{ selectedContact ? '' : 'hidden' }}
               data-i18n-aria-label="Tindakan percakapan">
                <button id="roomModeButton" class="button" type="button" data-i18n-auto {{ selectedContact?.schedule_paused ? 'disabled' : '' }}>
                  {{ selectedContact?.handling_mode === 'cs' ? 'Aktifkan AI' : 'Ambil alih' }}
                </button>
                <button
                  id="roomExclusionButton"
                  class="wa-setting-icon wa-icon-exclude"
                  type="button"
                  aria-label="Jangan dibalas AI"
                  title="Jangan dibalas AI"
                  aria-pressed="{{ selectedContact?.ai_excluded ? 'true' : 'false' }}"
                 data-i18n="Jangan dibalas AI" data-i18n-aria-label="Jangan dibalas AI" data-i18n-title="Jangan dibalas AI">
                  Jangan dibalas AI
                </button>
                <button id="contactDeleteButton" class="wa-icon-button wa-contact-delete-trigger" type="button"
                  aria-label="Hapus data pelanggan" title="Hapus data pelanggan"
                  data-i18n-aria-label="Hapus data pelanggan" data-i18n-title="Hapus data pelanggan">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                    <path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7" />
                  </svg>
                </button>
                <button id="roomSearchButton" class="wa-icon-button" type="button" aria-label="Cari di chat ini" title="Cari di chat ini"
                  aria-controls="roomSearchBar" aria-expanded="false" data-i18n-aria-label="Cari di chat ini" data-i18n-title="Cari di chat ini">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="6.5" /><path d="M20 20l-4.2-4.2" />
                  </svg>
                </button>
                <span class="wa-room-action-divider" aria-hidden="true"></span>
                <button
                  id="cartOpen"
                  class="wa-icon-button wa-cart-trigger"
                  type="button"
                  title="{{ (leanMode || beta3Mode) ? 'Pesanan' : 'Cart & Order' }}"
                  aria-label="{{ (leanMode || beta3Mode) ? 'Pesanan' : 'Cart dan order' }}"
                  data-i18n-title="{{ (leanMode || beta3Mode) ? 'Pesanan' : 'Cart & Order' }}"
                  data-i18n-aria-label="{{ (leanMode || beta3Mode) ? 'Pesanan' : 'Cart dan order' }}"
                >
                  <svg
                    viewBox="0 0 24 24"
                    width="19"
                    height="19"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M3 3h2l2.4 12h11.2L21 7H6M8 15l-1 3h12" />
                    <circle cx="9" cy="21" r="1" />
                    <circle cx="18" cy="21" r="1" />
                  </svg>
                  <span id="cartCount" class="wa-cart-count" aria-hidden="true" hidden></span>
                  <span id="cartMoney" class="wa-cart-money" aria-hidden="true" hidden>
                    <svg viewBox="0 0 20 16" width="15" height="12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="1" y="1" width="18" height="14" rx="2" />
                      <circle cx="10" cy="8" r="3" />
                      <path d="M4 8h1m10 0h1" />
                    </svg>
                  </span>
                </button>
              </div>
            </div>
            <section id="roomHandlingDetails" class="wa-handling-details" role="region" aria-labelledby="roomHandlingDetailsTitle" hidden>
              <header>
                <strong id="roomHandlingDetailsTitle" data-i18n="Detail penanganan">Detail penanganan</strong>
                <button id="roomHandlingDetailsClose" type="button" aria-label="Tutup" data-i18n-aria-label="Tutup">×</button>
              </header>
              <div id="roomHandlingDetailsBody"></div>
            </section>
            <div id="roomSearchBar" class="wa-room-search" role="search" hidden>
              <input id="roomSearchInput" type="search" autocomplete="off" spellcheck="false"
                placeholder="Cari di chat ini" aria-label="Cari di chat ini"
                data-i18n-placeholder="Cari di chat ini" data-i18n-aria-label="Cari di chat ini" />
              <small id="roomSearchCount" aria-live="polite"></small>
              <button id="roomSearchPrev" type="button" class="wa-icon-button" aria-label="Hasil sebelumnya" title="Hasil sebelumnya" data-i18n-aria-label="Hasil sebelumnya" data-i18n-title="Hasil sebelumnya">↑</button>
              <button id="roomSearchNext" type="button" class="wa-icon-button" aria-label="Hasil berikutnya" title="Hasil berikutnya" data-i18n-aria-label="Hasil berikutnya" data-i18n-title="Hasil berikutnya">↓</button>
              <button id="roomSearchClose" type="button" class="wa-icon-button" aria-label="Tutup" title="Tutup" data-i18n-aria-label="Tutup" data-i18n-title="Tutup">×</button>
            </div>
            <div
              id="messages"
              class="wa-messages"
              data-jid="{{ selectedJid }}"
              data-last-id="{{ messages.length ? messages[messages.length - 1].id : 0 }}"
            >
              <div id="messageList" class="wa-message-list">
              @each(message in messages)
                <article
                  class="message {{ message.direction === 'out' ? 'out' : 'in' }} source-{{ message.sender_type || (message.direction === 'out' ? 'cs' : 'customer') }} {{ message.media_type ? 'has-media' : '' }}"
                  data-id="{{ message.id }}"
                  data-message-id="{{ message.message_id }}"
                  data-body="{{ message.body }}"
                >
                  <div class="message-actions">
                    <button type="button" data-reply aria-label="Reply">↩</button>
                    <button type="button" data-reaction-toggle aria-label="Reaction">☺</button>
                    <div class="reaction-picker" hidden>
                      @each(emoji in ['👍', '❤️', '😂', '😮', '😢', '🙏'])
                        <button type="button" data-reaction="{{ emoji }}">{{ emoji }}</button>
                      @end
                    </div>
                  </div>
                  @if(message.reply)
                    <div class="message-reply-preview">
                      {{ message.reply.body || message.reply.media_type || 'Media' }}
                    </div>
                  @end
                  @if(message.media_type)
                    <div class="message-media-wrap">
                      @if(message.media_url && message.media_type === 'document')
                        <a class="message-document" href="{{ message.media_url }}" download>
                          {{ message.media_name || 'Dokumen' }}
                          ↓
                        </a>
                      @elseif(message.media_url && message.media_type === 'audio')
                        <audio
                          class="message-audio"
                          src="{{ message.media_url }}"
                          controls
                          preload="metadata"
                        ></audio>
                      @elseif(message.media_url && message.media_type === 'image')
                        <img class="message-media" src="{{ message.media_url }}" alt="" />
                      @elseif(message.media_url && message.media_type === 'gif')
                        <video
                          class="message-media"
                          src="{{ message.media_url }}"
                          poster="{{ message.thumbnail_url || '' }}"
                          autoplay
                          loop
                          muted
                          playsinline
                        ></video>
                      @elseif(message.media_url && message.media_type === 'video')
                        <video
                          class="message-media"
                          src="{{ message.media_url }}"
                          poster="{{ message.thumbnail_url || '' }}"
                          controls
                          playsinline
                          preload="metadata"
                        ></video>
                      @elseif(message.media_url && message.media_type === 'sticker')
                        <img class="message-media sticker" src="{{ message.media_url }}" alt="" />
                      @elseif(message.thumbnail_url)
                        <img
                          class="message-media thumbnail {{ message.media_type === 'sticker' ? 'sticker' : '' }}"
                          src="{{ message.thumbnail_url }}"
                          alt=""
                        />
                      @else
                        <div class="message-media-placeholder" aria-hidden="true"></div>
                      @end
                      @if(message.media_status === 'downloading')
                        <span class="message-media-state" data-i18n="Mengunduh…">Mengunduh…</span>
                      @elseif(message.media_status === 'failed')
                        <span class="message-media-state failed" data-i18n="Gagal dimuat">Gagal dimuat</span>
                      @end
                    </div>
                  @end

                  <div class="message-meta">
                    @if(message.direction === 'out')
                      <span class="message-source-badge">
                        {{ message.sender_type === 'ai' ? 'AI' : 'CS' }}
                      </span>
                    @else
                      {{ message.contact_name || message.jid }}
                    @end
                  </div>
                  @if(message.body)
                    <div class="message-body">{{ message.body }}</div>
                  @end

                  <div class="message-footer">
                    <span class="message-reactions">
                      @each(reaction in message.reactions)
                        <span>{{ reaction.emoji }}</span>
                      @end
                    </span>
                    @if(message.direction === 'out')
                      <span class="message-status {{ message.status }}">
                        {{
                          ['read', 'delivered'].includes(message.status)
                            ? '✓✓'
                            : message.status === 'failed'
                              ? '!'
                              : '✓'
                        }}
                      </span>
                    @end
                  </div>
                  @if(message.trace_id)
                    <button
                      type="button"
                      class="wa-trace-link"
                      data-trace-id="{{ message.trace_id }}"
                     data-i18n="Detail proses">
                      Detail proses
                    </button>
                  @end
                </article>
              @else
                <div class="wa-empty" data-i18n="Pilih kontak">Pilih kontak</div>
              @end
              </div>
            </div>
            <button
              id="aiProgress"
              class="wa-ai-progress"
              type="button"
              aria-haspopup="dialog"
              hidden
            >
              <span id="aiProgressLabel" role="status"></span>
              <span data-i18n="Detail proses ›">Detail proses ›</span>
            </button>
            <form id="messageForm" class="wa-composer" enctype="multipart/form-data">
              <div id="replyComposer" class="wa-reply-composer" hidden>
