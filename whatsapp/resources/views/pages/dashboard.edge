                title="Kembali ke daftar chat"
                data-i18n-title="Kembali ke daftar chat"
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M15 18l-6-6 6-6" />
                </svg>
              </a>
              @if(selectedContact)
                @if(selectedContact.profile_picture_url)
                  <img
                    id="roomAvatar"
                    class="wa-room-avatar"
                    src="{{ selectedContact.profile_picture_url }}"
                    alt=""
                  />
                @else
                  <span id="roomAvatar" class="wa-room-avatar">
                    {{
                      (selectedContact.contact_name || selectedJid)
                        .slice(0, 1)
                        .toUpperCase()
                    }}
                  </span>
                @end
              @end

              <div class="wa-room-identity">
                <strong id="roomName">
                  {{
                    selectedContact
                      ? selectedContact.contact_name || (selectedJid.endsWith('@ig') ? 'Instagram' : selectedJid.endsWith('@lid') ? 'Tanpa nama' : '+' + selectedJid.split('@')[0])
                      : 'Chat'
                  }}
                </strong>
                <div id="roomStatus" class="wa-room-status" {{ selectedContact ? '' : 'hidden' }}>
                  <button id="roomMode" type="button" class="wa-room-mode {{ selectedContact?.handling_mode }}"
                    aria-expanded="false" aria-controls="roomHandlingDetails"
                    data-reason="{{ selectedContact?.handoff_reason || '' }}"
                    data-schedule-paused="{{ selectedContact?.schedule_paused ? 'true' : 'false' }}"
                    data-note="{{ selectedContact?.handling_note || '' }}"
                    data-waiting="{{ selectedContact?.goal_waiting_for || '' }}"
                    data-next="{{ selectedContact?.goal_next_action || '' }}">
                    <svg class="wa-ico" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="{{ selectedContact?.handling_mode === 'cs' ? 'M12 11.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM5 20c0-4 3-6 7-6s7 2 7 6' : 'M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z' }}" /></svg>
                    <span class="wa-sr" data-i18n-auto>{{ selectedContact?.ai_excluded ? 'Tanpa AI' : selectedContact?.handling_mode === 'cs' ? 'Ditangani CS' : 'Ditangani AI' }}</span>
                  </button>
                  <small id="roomGoalStatus" class="wa-muted" aria-live="polite"></small>
                </div>
              </div>
              <div
                id="roomHandling"
                class="wa-room-handling"
                role="group"
                aria-label="Tindakan percakapan"
                data-mode="{{ selectedContact ? selectedContact.handling_mode : 'ai' }}"
                {{ selectedContact ? '' : 'hidden' }}
               data-i18n-aria-label="Tindakan percakapan">
                <button id="roomSearchButton" class="wa-icon-button" type="button" aria-label="Cari di chat ini" title="Cari di chat ini"
                  aria-controls="roomSearchBar" aria-expanded="false" data-i18n-aria-label="Cari di chat ini" data-i18n-title="Cari di chat ini">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="6.5" /><path d="M20 20l-4.2-4.2" />
                  </svg>
                </button>
                <button
                  id="cartOpen"
                  class="wa-icon-button wa-cart-trigger"
                  type="button"
                  title="Pesanan"
                  aria-label="Pesanan"
                  data-i18n-title="Pesanan"
                  data-i18n-aria-label="Pesanan"
                >
                  <svg
                    viewBox="0 0 24 24"
                    width="19"
                    height="19"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
