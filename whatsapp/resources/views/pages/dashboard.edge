                <button type="button" id="cancelReply" aria-label="Batal reply" data-i18n-aria-label="Batal reply">×</button>
              </div>
              <div id="mediaComposer" class="wa-media-composer" hidden>
                <img id="mediaPreview" alt="Pratinjau lampiran" hidden / data-i18n-alt="Pratinjau lampiran">
                <span id="mediaFileName"></span>
                <button type="button" id="cancelMedia" aria-label="Batal lampiran" data-i18n-aria-label="Batal lampiran">×</button>
              </div>
              <input
                id="mediaInput"
                name="media"
                type="file"
                accept=".jpg,.jpeg,.png,.webp,.gif,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.zip,.mp4,.mov,.mp3,.ogg,.m4a,.wav"
                hidden
                {{ selectedJid ? '' : 'disabled' }}
              />
              <button
                id="attachMedia"
                class="button wa-attach"
                type="button"
                aria-label="Lampirkan file"
