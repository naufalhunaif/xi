            </section>
            <div id="roomSearchBar" class="wa-room-search" role="search" hidden>
              <input id="roomSearchInput" type="search" autocomplete="off" spellcheck="false"
                placeholder="Cari di chat ini" aria-label="Cari di chat ini"
                data-i18n-placeholder="Cari di chat ini" data-i18n-aria-label="Cari di chat ini" />
              <small id="roomSearchCount" aria-live="polite"></small>
              <button id="roomSearchPrev" type="button" class="wa-icon-button" aria-label="Hasil sebelumnya" title="Hasil sebelumnya" data-i18n-aria-label="Hasil sebelumnya" data-i18n-title="Hasil sebelumnya">↑</button>
              <button id="roomSearchNext" type="button" class="wa-icon-button" aria-label="Hasil berikutnya" title="Hasil berikutnya" data-i18n-aria-label="Hasil berikutnya" data-i18n-title="Hasil berikutnya">↓</button>
              <button id="roomSearchClose" type="button" class="wa-icon-button" aria-label="Tutup" title="Tutup" data-i18n-aria-label="Tutup" data-i18n-title="Tutup">×</button>
            </div>
            <div
              id="messages"
              class="wa-messages"
              data-jid="{{ selectedJid }}"
              data-last-id="{{ messages.length ? messages[messages.length - 1].id : 0 }}"
            >
              <div id="messageList" class="wa-message-list {{ messages.length ? 'wa-ssr-pending' : '' }}">
              @if(messages.length)
                <div class="wa-loading" data-i18n="Memuat…">Memuat…</div>
              @end
              @each(message in messages)
                <article
                  class="message {{ message.direction === 'out' ? 'out' : 'in' }} source-{{ message.sender_type || (message.direction === 'out' ? 'cs' : 'customer') }} {{ message.media_type ? 'has-media' : '' }}"
                  data-id="{{ message.id }}"
                  data-message-id="{{ message.message_id }}"
                  data-body="{{ message.body }}"
                >
                  <div class="message-actions">
                    <button type="button" data-reply aria-label="Reply">↩</button>
                    <button type="button" data-reaction-toggle aria-label="Reaction">☺</button>
                    <div class="reaction-picker" hidden>
                      @each(emoji in ['👍', '❤️', '😂', '😮', '😢', '🙏'])
                        <button type="button" data-reaction="{{ emoji }}">{{ emoji }}</button>
                      @end
                    </div>
                  </div>
                  @if(message.reply)
                    <div class="message-reply-preview">
                      {{ message.reply.body || message.reply.media_type || 'Media' }}
                    </div>
                  @end
                  @if(message.media_type)
                    <div class="message-media-wrap">
                      @if(message.media_url && message.media_type === 'document')
                        <a class="message-document" href="{{ message.media_url }}" download>
                          {{ message.media_name || 'Dokumen' }}
                          ↓
                        </a>
                      @elseif(message.media_url && message.media_type === 'audio')
                        <audio
                          class="message-audio"
                          src="{{ message.media_url }}"
                          controls
                          preload="metadata"
                        ></audio>
                      @elseif(message.media_url && message.media_type === 'image')
                        <img class="message-media" src="{{ message.media_url }}" alt="" />
                      @elseif(message.media_url && message.media_type === 'gif')
                        <video
                          class="message-media"
                          src="{{ message.media_url }}"
                          poster="{{ message.thumbnail_url || '' }}"
                          autoplay
                          loop
                          muted
                          playsinline
                        ></video>
                      @elseif(message.media_url && message.media_type === 'video')
                        <video
                          class="message-media"
                          src="{{ message.media_url }}"
                          poster="{{ message.thumbnail_url || '' }}"
                          controls
                          playsinline
                          preload="metadata"
                        ></video>
                      @elseif(message.media_url && message.media_type === 'sticker')
                        <img class="message-media sticker" src="{{ message.media_url }}" alt="" />
                      @elseif(message.thumbnail_url)
                        <img
                          class="message-media thumbnail {{ message.media_type === 'sticker' ? 'sticker' : '' }}"
                          src="{{ message.thumbnail_url }}"
                          alt=""
                        />
                      @else
                        <div class="message-media-placeholder" aria-hidden="true"></div>
                      @end
                      @if(message.media_url)
                      @elseif(['downloading', 'retry', 'history', 'history_wait'].includes(message.media_status))
                        <span class="message-media-state" data-i18n="Mengunduh…">Mengunduh…</span>
                      @elseif(['failed', 'later', 'expired'].includes(message.media_status))
                        <button type="button" class="message-media-state" data-media-retry="{{ message.message_id }}" data-i18n="Muat ulang">Muat ulang</button>
                      @end
                    </div>
                  @end

                  <div class="message-meta">
                    @if(message.direction === 'out')
                      <span class="message-source-badge">
                        {{ message.sender_type === 'ai' ? 'AI' : 'CS' }}
                      </span>
                    @else
                      {{ message.contact_name || message.jid }}
                    @end
                  </div>
                  @if(message.body)
                    <div class="message-body">{{ message.body }}</div>
                  @end

                  <div class="message-footer">
                    <span class="message-reactions">
                      @each(reaction in message.reactions)
                        <span>{{ reaction.emoji }}</span>
                      @end
                    </span>
                    @if(message.direction === 'out')
                      <span class="message-status {{ message.status }}">
                        {{
                          ['read', 'delivered'].includes(message.status)
                            ? '✓✓'
                            : message.status === 'failed'
                              ? '!'
                              : '✓'
                        }}
                      </span>
                    @end
                  </div>
                  @if(message.trace_id)
                    <button
                      type="button"
                      class="wa-trace-link"
                      data-trace-id="{{ message.trace_id }}"
                     data-i18n="Detail proses">
                      Detail proses
                    </button>
                  @end
                </article>
              @else
                <div class="wa-empty" data-i18n="Pilih kontak">Pilih kontak</div>
              @end
              </div>
            </div>
            <button
              id="aiProgress"
              class="wa-ai-progress"
              type="button"
              aria-haspopup="dialog"
              hidden
            >
              <span id="aiProgressLabel" role="status"></span>
              <span data-i18n="Detail proses ›">Detail proses ›</span>
