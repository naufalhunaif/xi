                <section id="settings-backup" data-settings-panel="backup" aria-labelledby="settings-title-backup">
                  <h3 class="wa-settings-section-title" id="settings-title-backup"><svg class="wa-i" aria-hidden="true"><use href="#i-cloud"/></svg><span>Backup</span></h3>
                  <p id="backupAlert" class="wa-alert" role="alert"></p>
                  <div class="wa-card" id="backupDriveCard">
                    <div class="wa-card-head">
                      <div class="wa-card-title">
                        <strong>Google Drive</strong>
                        <small data-i18n="Cadangan semua data ke Drive Anda">Cadangan semua data ke Drive Anda</small>
                      </div>
                      <div class="actions"><span id="backupDriveState" class="wa-pill"><span class="wa-loading inline" data-i18n="Memuat…">Memuat…</span></span></div>
                    </div>
                    <div id="backupSetup" class="wa-form-grid" hidden>
                      <label><span>Client ID</span><input id="backupClientId" type="text" autocomplete="off" data-settings-ignore /></label>
                      <label><span>Client Secret</span><input id="backupClientSecret" type="password" autocomplete="off" data-settings-ignore /></label>
                      <div class="wa-kv wa-span-full"><div class="wa-kv-row"><span>Redirect URI</span><code id="backupRedirect"></code><button type="button" class="button small" data-copy="backupRedirect" data-i18n="Salin">Salin</button></div></div>
                      <details class="wa-span-full">
                        <summary data-i18n="Cara membuat Client ID (sekali saja)">Cara membuat Client ID (sekali saja)</summary>
                        <ol class="wa-note">
                          <li>console.cloud.google.com → create a project → APIs &amp; Services → Library → enable <b>Google Drive API</b>.</li>
                          <li>OAuth consent screen → External → fill in the app name &amp; email → add your email as a Test user.</li>
                          <li>Credentials → Create credentials → OAuth client ID → Web application → Authorized redirect URI = the Redirect URI above.</li>
                          <li>Copy the Client ID &amp; Client Secret here, then Connect. Keep both: they are needed again when restoring on a new VPS.</li>
                        </ol>
                      </details>
                    </div>
                    <div class="actions wa-actions-start">
                      <button type="button" class="button primary" id="backupConnect" hidden><svg class="wa-i" aria-hidden="true"><use href="#i-link"/></svg><span data-i18n="Hubungkan Google Drive">Hubungkan Google Drive</span></button>
                      <button type="button" class="button" id="backupDisconnect" hidden><svg class="wa-i" aria-hidden="true"><use href="#i-unlink"/></svg><span data-i18n="Putuskan">Putuskan</span></button>
                    </div>
                  </div>
                  <div class="wa-card" id="backupRunCard">
                    <div class="wa-card-head">
                      <div class="wa-card-title">
                        <strong data-i18n="Cadangkan">Cadangkan</strong>
                        <small id="backupLast"><span class="wa-loading inline" data-i18n="Memuat…">Memuat…</span></small>
                      </div>
                      <div class="actions"><button type="button" class="button primary" id="backupNow"><svg class="wa-i" aria-hidden="true"><use href="#i-upload"/></svg><span data-i18n="Backup sekarang">Backup sekarang</span></button></div>
                    </div>
                    <label class="wa-toggle-row"><span data-i18n="Backup otomatis tiap hari">Backup otomatis tiap hari</span>
                      <button class="wa-switch" type="button" role="switch" id="backupAuto" aria-checked="true" value="true" aria-label="Automatic backup"></button></label>
                    <label class="wa-toggle-row"><span><span data-i18n="Sertakan foto &amp; media chat">Sertakan foto &amp; media chat</span></span>
                      <button class="wa-switch" type="button" role="switch" id="backupMedia" aria-checked="true" value="true" aria-label="Sertakan media"></button></label>
