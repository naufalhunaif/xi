                  stroke-width="1.7"
                  aria-hidden="true"
                >
                  <path
                    d="m21 11-8.5 8.5a6 6 0 0 1-8.5-8.5l9-9a4 4 0 0 1 5.7 5.7l-9 9a2 2 0 0 1-2.8-2.8l8.5-8.5"
                  />
                </svg>
              </button>
              <input name="jid" type="hidden" value="{{ selectedJid }}" />
              <input name="replyToId" type="hidden" value="" />
              <input name="replyToMessageId" type="hidden" value="" />
              <input
                name="body"
                type="text"
                maxlength="4096"
                autocomplete="off"
                placeholder="Pesan"
                {{ selectedJid ? '' : 'disabled' }}
              / data-i18n-placeholder="Pesan">
              <button class="button primary" type="submit" {{ selectedJid ? '' : 'disabled' }} data-i18n="Kirim">
                Kirim
              </button>
