                  >
                    <path d="M3 3h2l2.4 12h11.2L21 7H6M8 15l-1 3h12" />
                    <circle cx="9" cy="21" r="1" />
                    <circle cx="18" cy="21" r="1" />
                  </svg>
                  <span id="cartCount" class="wa-cart-count" aria-hidden="true" hidden></span>
                  <span id="cartMoney" class="wa-cart-money" aria-hidden="true" hidden>
                    <svg viewBox="0 0 20 16" width="15" height="12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="1" y="1" width="18" height="14" rx="2" />
                      <circle cx="10" cy="8" r="3" />
