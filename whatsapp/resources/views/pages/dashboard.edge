              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M15 18l-6-6 6-6" />
                </svg>
              </a>
              @if(selectedContact)
                @if(selectedContact.profile_picture_url)
                  <img
                    id="roomAvatar"
                    class="wa-room-avatar"
                    src="{{ selectedContact.profile_picture_url }}"
                    alt=""
                  />
                @else
                  <span id="roomAvatar" class="wa-room-avatar">
                    {{
                      (selectedContact.contact_name || selectedJid)
                        .slice(0, 1)
                        .toUpperCase()
                    }}
                  </span>
                @end
              @end

              <div class="wa-room-identity">
                <strong id="roomName">
                  {{
                    selectedContact
                      ? selectedContact.contact_name || (selectedJid.endsWith('@ig') ? 'Instagram' : selectedJid.endsWith('@lid') ? 'Tanpa nama' : '+' + selectedJid.split('@')[0])
                      : 'Chat'
                  }}
                </strong>
                <div id="roomStatus" class="wa-room-status" {{ selectedContact ? '' : 'hidden' }}>
                  <button id="roomMode" type="button" class="wa-room-mode {{ selectedContact?.handling_mode }}" data-i18n-auto
                    aria-expanded="false" aria-controls="roomHandlingDetails"
                    data-reason="{{ selectedContact?.handoff_reason || '' }}"
                    data-schedule-paused="{{ selectedContact?.schedule_paused ? 'true' : 'false' }}"
                    data-note="{{ selectedContact?.handling_note || '' }}"
                    data-waiting="{{ selectedContact?.goal_waiting_for || '' }}"
                    data-next="{{ selectedContact?.goal_next_action || '' }}">
                    {{ selectedContact?.ai_excluded ? 'Tanpa AI' : selectedContact?.handling_mode === 'cs' ? 'Ditangani CS' : 'Ditangani AI' }}
                  </button>
                  <small id="roomGoalStatus" class="wa-muted" aria-live="polite"></small>
                </div>
              </div>
              <div
                id="roomHandling"
                class="wa-room-handling"
                role="group"
                aria-label="Tindakan percakapan"
                data-mode="{{ selectedContact ? selectedContact.handling_mode : 'ai' }}"
                {{ selectedContact ? '' : 'hidden' }}
               data-i18n-aria-label="Tindakan percakapan">
                <button id="roomModeButton" class="button" type="button" data-i18n-auto {{ selectedContact?.schedule_paused ? 'disabled' : '' }}>
                  {{ selectedContact?.handling_mode === 'cs' ? 'Aktifkan AI' : 'Ambil alih' }}
                </button>
                <button
                  id="roomExclusionButton"
                  class="wa-setting-icon wa-icon-exclude"
                  type="button"
                  aria-label="Jangan dibalas AI"
                  title="Jangan dibalas AI"
                  aria-pressed="{{ selectedContact?.ai_excluded ? 'true' : 'false' }}"
                 data-i18n="Jangan dibalas AI" data-i18n-aria-label="Jangan dibalas AI" data-i18n-title="Jangan dibalas AI">
                  Jangan dibalas AI
                </button>
                <button id="contactDeleteButton" class="wa-icon-button wa-contact-delete-trigger" type="button"
                  aria-label="Hapus data pelanggan" title="Hapus data pelanggan"
                  data-i18n-aria-label="Hapus data pelanggan" data-i18n-title="Hapus data pelanggan">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                    <path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7" />
                  </svg>
                </button>
                <button id="roomSearchButton" class="wa-icon-button" type="button" aria-label="Cari di chat ini" title="Cari di chat ini"
                  aria-controls="roomSearchBar" aria-expanded="false" data-i18n-aria-label="Cari di chat ini" data-i18n-title="Cari di chat ini">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="6.5" /><path d="M20 20l-4.2-4.2" />
                  </svg>
                </button>
                <span class="wa-room-action-divider" aria-hidden="true"></span>
                <button
                  id="cartOpen"
                  class="wa-icon-button wa-cart-trigger"
                  type="button"
                  title="{{ (leanMode || beta3Mode) ? 'Pesanan' : 'Cart & Order' }}"
                  aria-label="{{ (leanMode || beta3Mode) ? 'Pesanan' : 'Cart dan order' }}"
                  data-i18n-title="{{ (leanMode || beta3Mode) ? 'Pesanan' : 'Cart & Order' }}"
                  data-i18n-aria-label="{{ (leanMode || beta3Mode) ? 'Pesanan' : 'Cart dan order' }}"
                >
                  <svg
                    viewBox="0 0 24 24"
                    width="19"
                    height="19"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
