<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content="{{ csrfToken }}" />
    <title>{{ mode === 'setup' ? 'Create owner account' : 'Sign in' }} · Chat</title>
    <link rel="icon" href="{{ appUrl }}/assets/brand.svg" type="image/svg+xml" />
    <script src="{{ appUrl }}/assets/theme.js?v=1"></script>
    <link rel="stylesheet" href="{{ appUrl }}/assets/auth.css?v=3" />
  </head>
  <body>
    {{-- Gaya Wireframe (keluarga wireframe-services-grid): kartu putih minimal, ikon gelombang 3D kawat berputar. --}}
    <main class="page">
      <aside class="rail" aria-hidden="true"><h2>{{ mode === 'setup' ? 'First run' : 'Sign in' }}</h2><span class="mark"></span></aside>
      <section class="card" aria-labelledby="authTitle">
        <svg class="icon" id="authWave" viewBox="0 0 200 200" aria-hidden="true"></svg>
        <div class="text">
          @if(mode === 'setup')
            <h1 id="authTitle">Create owner account</h1>
            <p>No account yet · the first account owns the app</p>
          @else
            <h1 id="authTitle">Chat</h1>
            <p>Owner email &amp; password</p>
          @end
        </div>
        @if(error)
          <div class="error" role="alert">{{ error }}</div>
        @end
        <form method="post" action="{{ appUrl }}/{{ mode === 'setup' ? 'setup' : 'login' }}" autocomplete="on">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}" />
          @if(mode === 'setup')
            <label for="name">Name</label>
            <input id="name" name="name" type="text" value="{{ name }}" maxlength="120" autocomplete="name" />
          @end
          <label for="email">Email</label>
          <input id="email" name="email" type="email" value="{{ email }}" required autocomplete="username" autofocus />
          <label for="password">Password</label>
          <input id="password" name="password" type="password" required minlength="8" autocomplete="{{ mode === 'setup' ? 'new-password' : 'current-password' }}" />
          @if(mode === 'setup')
            <label for="password_confirm">Repeat password</label>
            <input id="password_confirm" name="password_confirm" type="password" required minlength="8" autocomplete="new-password" />
          @end
          <button type="submit">{{ mode === 'setup' ? 'Create account & sign in' : 'Sign in' }}</button>
        </form>
        <footer>v{{ appVersion }}</footer>
      </section>
    </main>
    <script src="{{ appUrl }}/assets/auth_wire.js?v=1" defer></script>
  </body>
</html>
