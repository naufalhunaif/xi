<div id="igContentPage" class="wa-ig-panel" data-ig-panel="content">
  <div class="wa-lean-toolbar">
    <div id="igpTabs" class="wa-order-tabs" role="group" aria-label="Filter postingan" data-i18n-aria-label="Filter postingan">
      <button type="button" data-filter="all" aria-pressed="true"><span data-i18n="Semua">Semua</span> <b class="wa-tab-count" data-count="all"></b></button>
      <button type="button" data-filter="scheduled" aria-pressed="false"><span data-i18n="Terjadwal">Terjadwal</span> <b class="wa-tab-count" data-count="scheduled"></b></button>
      <button type="button" data-filter="published" aria-pressed="false"><span data-i18n="Terbit">Terbit</span> <b class="wa-tab-count" data-count="published"></b></button>
      <button type="button" data-filter="story" aria-pressed="false"><span data-i18n="Story">Story</span> <b class="wa-tab-count" data-count="story"></b></button>
      <button type="button" data-filter="failed" aria-pressed="false"><span data-i18n="Gagal">Gagal</span> <b class="wa-tab-count" data-count="failed"></b></button>
    </div>
    <div class="wa-order-filters wa-igp-filters">
      <div id="igpKinds" class="wa-segmented wa-igp-kind-tabs" role="group" aria-label="Jenis" data-i18n-aria-label="Jenis">
        <button type="button" data-kind="all" aria-pressed="true" data-i18n="Semua">Semua</button>
        <button type="button" data-kind="posts" aria-pressed="false" title="Postingan" data-i18n-title="Postingan" aria-label="Postingan" data-i18n-aria-label="Postingan"><svg class="wa-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v16H4zM4 10h16M4 16h16M10 4v16M16 4v16"/></svg></button>
        <button type="button" data-kind="reels" aria-pressed="false" title="Reels" data-i18n-title="Reels" aria-label="Reels" data-i18n-aria-label="Reels"><svg class="wa-i" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M3 9h18M8 3l3 6M14 3l3 6M10 12.5v5l4-2.5z"/></svg></button>
        <button type="button" data-kind="story" aria-pressed="false" title="Story" data-i18n-title="Story" aria-label="Story" data-i18n-aria-label="Story"><svg class="wa-i" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5" stroke-dasharray="6 3"/><circle cx="12" cy="12" r="5"/></svg></button>
      </div>
      <div id="igpView" class="wa-segmented wa-igp-view" role="group" aria-label="Tampilan" data-i18n-aria-label="Tampilan">
        <button type="button" data-view="list" aria-pressed="true" title="Tampilan daftar" data-i18n-title="Tampilan daftar" aria-label="Tampilan daftar" data-i18n-aria-label="Tampilan daftar"><svg class="wa-i" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
        <button type="button" data-view="grid" aria-pressed="false" title="Tampilan grid" data-i18n-title="Tampilan grid" aria-label="Tampilan grid" data-i18n-aria-label="Tampilan grid"><svg class="wa-i" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="7" height="7"/><rect x="13" y="4" width="7" height="7"/><rect x="4" y="13" width="7" height="7"/><rect x="13" y="13" width="7" height="7"/></svg></button>
      </div>
      <input id="igpSearch" type="search" placeholder="Cari caption" data-i18n-placeholder="Cari caption" aria-label="Cari caption" data-i18n-aria-label="Cari caption">
    </div>
  </div>
  <p id="igpNotice" role="status" aria-live="polite"></p>
  <div class="wa-order-workspace">
    <div id="igpGrid" class="wa-igp-grid" role="list" aria-label="Postingan" data-i18n-aria-label="Postingan" hidden></div>
    <div id="igpTableWrap" class="wa-order-table-scroll" tabindex="0" role="region" aria-label="Postingan" data-i18n-aria-label="Postingan">
      <table class="wa-order-table wa-igp-table">
        <thead><tr>
          <th scope="col" data-i18n="Postingan">Postingan</th>
          <th scope="col" data-i18n="Waktu">Waktu</th>
          <th scope="col" class="wa-order-amount" data-i18n="Jangkauan">Jangkauan</th>
          <th scope="col" class="wa-order-amount" data-i18n="Tayangan">Tayangan</th>
          <th scope="col" class="wa-order-amount" data-i18n="Suka">Suka</th>
          <th scope="col" class="wa-order-amount" data-i18n="Komentar">Komentar</th>
          <th scope="col" class="wa-order-amount" title="Komentar yang bertanya (minat beli)" data-i18n="Tanya" data-i18n-title="Komentar yang bertanya (minat beli)">Tanya</th>
          <th scope="col" data-i18n="Status">Status</th>
        </tr></thead>
        <tbody id="igpList"><tr><td colspan="8"><div class="wa-loading" data-i18n="Memuat…">Memuat…</div></td></tr></tbody>
      </table>
    </div>
    <div id="igpMore" class="wa-igp-more"><button id="igpMoreButton" class="button" type="button" hidden data-i18n="Muat lebih banyak">Muat lebih banyak</button></div>
  </div>

</div>
  <div id="igpSummaryBox" class="wa-ig-panel wa-igp-detail wa-igp-summary-panel" data-ig-panel="summary">
    <section class="wa-b3-section wa-igp-analysis">
      <div class="wa-igp-head-row">
        <h3 data-i18n="Analisis AI">Analisis AI</h3>
        <button id="igpAnalyze" class="button small" type="button" data-i18n="Analisis sekarang">Analisis sekarang</button>
      </div>
      <div id="igpAnalysisBody"><div class="wa-loading" data-i18n="Memuat…">Memuat…</div></div>
    </section>
    <div class="wa-igp-summary-head">
      <div id="igpDays" class="wa-segmented" role="group" aria-label="Rentang" data-i18n-aria-label="Rentang">
        <button type="button" data-days="7" aria-pressed="true" data-i18n="7 hari">7 hari</button>
        <button type="button" data-days="14" aria-pressed="false" data-i18n="14 hari">14 hari</button>
        <button type="button" data-days="30" aria-pressed="false" data-i18n="30 hari">30 hari</button>
        <button type="button" data-days="90" aria-pressed="false" data-i18n="90 hari">90 hari</button>
      </div>
    </div>
    <div id="igpSummary"><div class="wa-loading" data-i18n="Memuat…">Memuat…</div></div>
  </div>
  <dialog id="igpDrawer" class="wa-order-drawer" data-motion="sheet" aria-labelledby="igpDrawerTitle">
    <header class="wa-order-drawer-header"><strong id="igpDrawerTitle"></strong><button id="igpDrawerClose" class="shell-icon-button" type="button" aria-label="Tutup" data-i18n-aria-label="Tutup" autofocus><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></header>
    <section id="igpDetail" class="wa-order-editor wa-igp-detail"></section>

    <form id="igpForm" class="wa-order-editor wa-igp-detail" hidden>
      <section class="wa-b3-section">
        <h3 data-i18n="Jenis">Jenis</h3>
        <div class="wa-segmented wa-igp-kinds" role="group" aria-label="Jenis" data-i18n-aria-label="Jenis">
          <button type="button" data-kind="feed" aria-pressed="true" data-i18n="Feed">Feed</button>
          <button type="button" data-kind="carousel" aria-pressed="false" data-i18n="Carousel">Carousel</button>
          <button type="button" data-kind="reels" aria-pressed="false" data-i18n="Reels">Reels</button>
          <button type="button" data-kind="story" aria-pressed="false" data-i18n="Story">Story</button>
        </div>
      </section>
      <section class="wa-b3-section">
        <h3 data-i18n="Foto/video">Foto/video</h3>
        <div id="igpMedia" class="wa-igp-media"></div>
        <label id="igpPick" class="wa-igp-pick button">
          <span id="igpPickLabel" data-i18n="Pilih foto/video">Pilih foto/video</span>
          <input id="igpFile" type="file" accept="image/*,video/mp4,video/quicktime" hidden />
        </label>
        <small id="igpHint" class="wa-muted"></small>
      </section>
      <section id="igpCaptionWrap" class="wa-b3-section">
        <div class="wa-igp-head-row">
          <h3 data-i18n="Caption">Caption</h3>
          <button id="igpAi" class="button small" type="button" data-i18n="Buat dengan AI">Buat dengan AI</button>
        </div>
        <div class="wa-igp-caption-box">
          <textarea id="igpCaption" rows="6" maxlength="2200" aria-label="Caption" data-i18n-aria-label="Caption"></textarea>
          <div id="igpAiLoading" class="wa-loading" hidden data-i18n="AI menulis caption…">AI menulis caption…</div>
        </div>
        <div class="wa-igp-caption-foot">
          <small id="igpAiStatus" class="wa-muted" role="status" aria-live="polite" data-i18n="Tulis poin singkat (opsional), lalu klik Buat dengan AI.">Tulis poin singkat (opsional), lalu klik Buat dengan AI.</small>
          <small id="igpCount" class="wa-muted wa-igp-count">0/2200</small>
        </div>
        <label id="igpFeedWrap" class="wa-check" hidden>
          <input id="igpShareFeed" type="checkbox" checked />
          <span data-i18n="Tampilkan juga di feed">Tampilkan juga di feed</span>
        </label>
      </section>
      <section class="wa-b3-section">
        <h3 data-i18n="Waktu">Waktu</h3>
        <div class="wa-igp-when">
          <label class="wa-check"><input type="radio" name="igpWhen" value="later" checked /> <span data-i18n="Jadwalkan">Jadwalkan</span></label>
          <label class="wa-check"><input type="radio" name="igpWhen" value="now" /> <span data-i18n="Posting sekarang">Posting sekarang</span></label>
        </div>
        <div class="wa-igp-at"><input id="igpAt" type="datetime-local" aria-label="Tanggal dan jam" data-i18n-aria-label="Tanggal dan jam" /><small class="wa-muted">WIB</small></div>
      </section>
      <p id="igpFormNotice" class="wa-igp-form-notice" role="status" aria-live="polite"></p>
      <div class="wa-b3-actions">
        <button id="igpCancel" class="button" type="button" data-i18n="Batal">Batal</button>
        <button id="igpSave" class="button primary" type="submit" data-i18n="Simpan jadwal">Simpan jadwal</button>
      </div>
    </form>
  </dialog>
