<section id="contactDirectory" class="wa-directory wa-orders-page">
  <div class="wa-directory-heading"><h1 data-i18n="Kontak & Alamat">Kontak & Alamat</h1><button id="directoryExport" class="button" type="button" aria-label="Ekspor CSV" title="Ekspor CSV" data-i18n-aria-label="Ekspor CSV" data-i18n-title="Ekspor CSV"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m-4-4 4 4 4-4M5 16v5h14v-5"/></svg><span data-i18n="Ekspor CSV">Ekspor CSV</span></button></div>
  <div class="wa-directory-toolbar"><input id="directorySearch" type="search" maxlength="100" placeholder="Cari kontak, nomor, atau alamat" aria-label="Cari kontak, nomor, atau alamat" data-i18n-placeholder="Cari kontak, nomor, atau alamat" data-i18n-aria-label="Cari kontak, nomor, atau alamat"><span id="directoryCount" class="wa-muted" aria-live="polite"></span></div>
  <p id="directoryNotice" role="status" aria-live="polite"></p>
  <div class="wa-directory-scroll" role="region" aria-label="Kontak & Alamat" data-i18n-aria-label="Kontak & Alamat" tabindex="0">
    <table class="wa-directory-table"><thead><tr><th scope="col" data-i18n="Kontak">Kontak</th><th scope="col" data-i18n="Nomor WhatsApp">Nomor WhatsApp</th><th scope="col" data-i18n="Alamat">Alamat</th></tr></thead><tbody id="directoryRows"></tbody></table>
  </div>
  <div class="wa-directory-pagination"><button id="directoryPrevious" class="button" type="button" data-i18n="Sebelumnya">Sebelumnya</button><span id="directoryPage" aria-live="polite"></span><button id="directoryNext" class="button" type="button" data-i18n="Berikutnya">Berikutnya</button></div>
</section>
