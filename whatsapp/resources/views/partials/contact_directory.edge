<section id="contactDirectory" class="wa-directory wa-orders-page">
  <div class="wa-orders-title">
    <div class="wa-page-heading"><span id="directoryCount" class="wa-eyebrow" aria-live="polite"></span><h1 data-i18n="Kontak & Alamat">Kontak & Alamat</h1></div>
    <div class="wa-orders-title-actions">
      <button id="directoryExport" class="button wa-icon-only" type="button" aria-label="Ekspor CSV" title="Ekspor CSV" data-i18n-aria-label="Ekspor CSV" data-i18n-title="Ekspor CSV"><svg class="wa-ico" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 4v11m-4-4 4 4 4-4M5 20h14" /></svg></button>
    </div>
  </div>
  <div class="wa-lean-toolbar">
    <span class="wa-toolbar-spacer"></span>
    <label class="wa-search-field"><svg class="wa-ico" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="m20 20-4.5-4.5" /></svg><input id="directorySearch" type="search" maxlength="100" placeholder="Cari kontak, nomor, atau alamat" aria-label="Cari kontak, nomor, atau alamat" data-i18n-placeholder="Cari kontak, nomor, atau alamat" data-i18n-aria-label="Cari kontak, nomor, atau alamat"></label>
  </div>
  <p id="directoryNotice" role="status" aria-live="polite"></p>
  <div class="wa-directory-scroll wa-order-table-scroll" role="region" aria-label="Kontak & Alamat" data-i18n-aria-label="Kontak & Alamat" tabindex="0">
    <table class="wa-directory-table wa-order-table"><thead><tr><th scope="col" data-i18n="Kontak">Kontak</th><th scope="col" data-i18n="Nomor">Nomor</th><th scope="col" data-i18n="Alamat">Alamat</th></tr></thead><tbody id="directoryRows"><tr><td colspan="3"><div class="wa-loading" data-i18n="Memuat…">Memuat…</div></td></tr></tbody></table>
  </div>
  <div class="wa-directory-pagination wa-pager">
    <span id="directoryPage" aria-live="polite"></span>
    <button id="directoryPrevious" class="button wa-icon-only" type="button" aria-label="Sebelumnya" title="Sebelumnya" data-i18n-aria-label="Sebelumnya" data-i18n-title="Sebelumnya"><svg class="wa-ico" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg></button>
    <button id="directoryNext" class="button wa-icon-only" type="button" aria-label="Berikutnya" title="Berikutnya" data-i18n-aria-label="Berikutnya" data-i18n-title="Berikutnya"><svg class="wa-ico" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg></button>
  </div>
</section>
