{{-- Orkestra AI: peta akun AI & pelanggan ala graph view. Akun aktif menyala, perpindahan terlihat. --}}
<aside id="aiOrchestra" class="wa-orchestra" aria-labelledby="aiOrchestraTitle">
  <div class="wa-orchestra-head">
    <div>
      <strong id="aiOrchestraTitle" data-i18n="Orkestra AI">Orkestra AI</strong>
      <small id="aiOrchestraNow" aria-live="polite"></small>
    </div>
    <button id="aiOrchestraExpand" type="button" class="button small" aria-pressed="false" data-i18n="Perbesar">Perbesar</button>
  </div>
  <div class="wa-orchestra-stage">
    <svg id="aiOrchestraGraph" role="img" aria-label="Peta akun AI dan pelanggan" data-i18n-aria-label="Peta akun AI dan pelanggan"></svg>
    <div id="aiOrchestraTip" class="wa-orchestra-tip" hidden></div>
    <small class="wa-orchestra-hint" data-i18n="Gulir untuk zoom · seret untuk geser · klik 2x untuk reset">Gulir untuk zoom · seret untuk geser · klik 2x untuk reset</small>
  </div>
  <div class="wa-orchestra-legend" aria-hidden="true">
    <span><i class="dot chatgpt"></i>ChatGPT</span>
    <span><i class="dot claude"></i>Claude</span>
    <span><i class="dot gemini"></i>Gemini</span>
    <span><i class="dot person"></i><span data-i18n="Pelanggan">Pelanggan</span></span>
    <span><i class="dot waiting"></i><span data-i18n="Belum dibalas">Belum dibalas</span></span>
    <span><i class="dot order"></i><span data-i18n="Order">Order</span></span>
    <span><i class="dot payment"></i><span data-i18n="Bayar">Bayar</span></span>
    <span><i class="dot cs"></i>CS</span>
  </div>
  <ol id="aiOrchestraLog" class="wa-orchestra-log" aria-label="Aktivitas AI terbaru" data-i18n-aria-label="Aktivitas AI terbaru"></ol>
</aside>
