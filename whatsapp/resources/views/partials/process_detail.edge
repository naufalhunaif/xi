<dialog id="aiTraceDialog" class="wa-trace-dialog" aria-labelledby="aiTraceTitle">
  <header class="wa-trace-header">
    <div>
      <h2 id="aiTraceTitle" data-i18n="Detail proses">Detail proses</h2>
      <span id="aiTraceStatus" role="status"></span>
    </div>
    <button type="button" id="aiTraceClose" class="button" aria-label="Tutup detail proses" data-i18n-aria-label="Tutup detail proses">
      ×
    </button>
  </header>
  <div id="aiTraceContent" class="wa-trace-content"></div>
</dialog>
