<dialog id="aiTraceDialog" class="wa-trace-dialog" aria-labelledby="aiTraceTitle">
  <header class="wa-trace-header">
    <div>
      <h2 id="aiTraceTitle" data-i18n="Kenapa AI membalas begini">Kenapa AI membalas begini</h2>
      <span id="aiTraceStatus" role="status"></span>
    </div>
    <button type="button" id="aiTraceClose" class="button wa-icon-close" aria-label="Tutup detail proses" title="Tutup detail proses" data-i18n-aria-label="Tutup detail proses" data-i18n-title="Tutup detail proses">
      <svg class="wa-ico" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
    </button>
  </header>
  <div id="aiTraceContent" class="wa-trace-content"></div>
</dialog>
