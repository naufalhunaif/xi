<dialog id="cartDialog" class="wa-cart-dialog" aria-labelledby="cartTitle" data-beta3-mode="true">
  <header class="wa-cart-header">
    <strong id="cartTitle" data-i18n="Pesanan">Pesanan</strong>
    <button type="button" id="cartClose" class="button" aria-label="Tutup cart" data-i18n-aria-label="Tutup cart">×</button>
  </header>
  <div class="wa-cart-layout">
  <div class="wa-cart-body" id="beta3RoomPanel">
    <div id="beta3RoomNotice" role="status" hidden></div>
    <p id="beta3RoomStatus" class="wa-b3-status"></p>
    <section class="wa-cart-section">
      <h3 data-i18n="Pesanan">Pesanan</h3>
      <div id="beta3RoomPhotos" class="wa-b3-photos" hidden></div>
      <pre id="beta3RoomText" class="wa-b3-spec"><span class="wa-loading inline" data-i18n="Memuat…">Memuat…</span></pre>
    </section>
    <section class="wa-cart-section">
      <div class="wa-cart-heading"><h3 data-i18n="Order">Order</h3><small id="beta3RoomOrderStatus" class="wa-muted"></small></div>
      <div id="beta3RoomOrder"><div class="wa-loading" data-i18n="Memuat…">Memuat…</div></div>
    </section>
    <details class="wa-cart-section wa-b3-edit">
      <summary data-i18n="Ubah detail pesanan">Ubah detail pesanan</summary>
      <textarea id="beta3RoomSpec" rows="6"></textarea>
      <div class="actions"><button id="beta3RoomSpecSave" type="button" class="button" data-i18n="Simpan">Simpan</button></div>
    </details>
  </div>
  </div>
</dialog>
