<section id="beta3Page" class="wa-orders-page wa-lean-page wa-ai-page">
  <div class="wa-orders-title">
    <div class="wa-page-heading">
      <span id="beta3SyncedAt" class="wa-eyebrow"></span>
      <h1 data-i18n="AI">AI</h1>
    </div>
    <div class="wa-orders-title-actions">
      <button id="beta3Sync" class="button wa-icon-only" type="button" aria-label="Sync katalog" title="Tarik katalog terbaru dari MCP" data-i18n-aria-label="Sync katalog" data-i18n-title="Tarik katalog terbaru dari MCP"><svg class="wa-ico" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7" /></svg></button>
      <button id="beta3McpOpen" type="button" class="button wa-icon-only" aria-label="Sumber data" title="Sumber data" data-i18n-aria-label="Sumber data" data-i18n-title="Sumber data" aria-haspopup="dialog" aria-controls="beta3McpDialog" aria-expanded="false"><svg class="wa-ico" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9 7 7M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1"/></svg></button>
    </div>
  </div>
  <p id="beta3Notice" role="status" aria-live="polite"></p>

  <dialog id="beta3McpDialog" class="wa-order-routing" aria-labelledby="beta3McpTitle">
    <header class="wa-order-routing-header"><strong id="beta3McpTitle" data-i18n="Sumber data">Sumber data</strong><button id="beta3McpClose" class="shell-icon-button" type="button" aria-label="Tutup" data-i18n-aria-label="Tutup" autofocus>×</button></header>
    <p class="wa-muted" data-i18n="Beta 3 memakai koneksi MCP yang sama dengan Pengaturan → Data bisnis. Pilih sumbernya di sini; kalau statusnya belum Terhubung, tekan Hubungkan di Data bisnis dulu.">Beta 3 memakai koneksi MCP yang sama dengan Pengaturan → Data bisnis. Pilih sumbernya di sini; kalau statusnya belum Terhubung, tekan Hubungkan di Data bisnis dulu.</p>
    <form id="beta3McpForm" class="wa-order-fields">
      <label><span data-i18n="Koneksi">Koneksi</span><select id="beta3McpSlug"><option value="" data-i18n="— otomatis —">— otomatis —</option></select></label>
      <div class="actions"><button class="button" type="submit" data-i18n="Simpan & uji">Simpan & uji</button></div>
    </form>
    <small id="beta3McpStatus" class="wa-muted" role="status"></small>
  </dialog>

  <div class="wa-ai-grid">
  <div class="wa-ai-col">
  <section class="wa-lean-card">
    <div class="wa-lean-card-head">
      <div><h2 class="wa-card-eyebrow" data-i18n="Katalog">Katalog</h2></div>
      <div class="actions">
        <button id="beta3DigestOpen" class="wa-mini" type="button" aria-label="Lihat digest" title="Lihat digest" data-i18n-aria-label="Lihat digest" data-i18n-title="Lihat digest"><svg class="wa-ico" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12z" /><circle cx="12" cy="12" r="2.5" /></svg></button>
        <button id="beta3ImportOpen" class="wa-mini" type="button" aria-label="Impor JSON" title="Impor JSON" data-i18n-aria-label="Impor JSON" data-i18n-title="Impor JSON"><svg class="wa-ico" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M12 15V4m-4 4 4-4 4 4M5 20h14" /></svg></button>
      </div>
    </div>
    <div class="wa-catalog-summary">
      <strong id="beta3CatalogStatus" class="wa-catalog-total" role="status"></strong>
      <small data-i18n="Ditawarkan AI · diambil dari website toko tiap 30 menit">Ditawarkan AI · diambil dari website toko tiap 30 menit</small>
    </div>
    <dl id="beta3CatalogStats" class="wa-catalog-stats" hidden>
      <div><dt data-i18n="Tampil di website">Tampil di website</dt><dd data-stat="onWeb"></dd></div>
      <div><dt data-i18n="Ada stok ready">Ada stok ready</dt><dd data-stat="ready"></dd></div>
      <div data-stat-row="inactive"><dt data-i18n="Nonaktif, tidak ditawarkan">Nonaktif, tidak ditawarkan</dt><dd data-stat="inactive"></dd></div>
      <div><dt data-i18n="Terakhir berubah">Terakhir berubah</dt><dd data-stat="changedAt"></dd></div>
    </dl>
    <details class="wa-line-more"><summary data-i18n="Detail teknis">Detail teknis</summary><p id="beta3CatalogTech" class="wa-muted"></p></details>
  </section>
  <section class="wa-lean-card">
    <div class="wa-lean-card-head"><div><h2 class="wa-card-eyebrow" data-i18n="Pola harga">Pola harga</h2></div></div>
    <div id="beta3PriceTable" class="wa-price-table"><span class="wa-loading" data-i18n="Memuat…">Memuat…</span></div>
    <details class="wa-line-more"><summary data-i18n="Teks yang dibaca AI">Teks yang dibaca AI</summary><pre id="beta3PricePattern" class="wa-lean-digest"></pre></details>
  </section>
  </div>

  <dialog id="beta3DigestDialog" class="wa-order-drawer" data-motion="sheet" aria-labelledby="beta3DigestTitle">
    <header class="wa-order-drawer-header"><strong id="beta3DigestTitle" data-i18n="Digest katalog">Digest katalog</strong><button id="beta3DigestClose" class="shell-icon-button" type="button" aria-label="Tutup" data-i18n-aria-label="Tutup" autofocus>×</button></header>
    <section class="wa-order-editor"><pre id="beta3CatalogDigest" class="wa-lean-digest wa-lean-digest--full"></pre></section>
  </dialog>

  <dialog id="beta3ImportDialog" class="wa-order-routing" aria-labelledby="beta3ImportTitle">
    <header class="wa-order-routing-header"><strong id="beta3ImportTitle" data-i18n="Impor katalog dari JSON">Impor katalog dari JSON</strong><button id="beta3ImportClose" class="shell-icon-button" type="button" aria-label="Tutup" data-i18n-aria-label="Tutup" autofocus>×</button></header>
    <p class="wa-muted" data-i18n="Pilih file .json berisi array produk (atau objek dengan field items). Satu objek per varian: product, color, price, sizesReady, photoUrl, materialAvailable.">Pilih file .json berisi array produk (atau objek dengan field items). Satu objek per varian: product, color, price, sizesReady, photoUrl, materialAvailable.</p>
    <form id="beta3CatalogForm" class="wa-order-fields">
      <label><span data-i18n="File JSON">File JSON</span><input id="beta3CatalogFile" type="file" accept=".json,application/json" required></label>
      <small id="beta3CatalogFileInfo" class="wa-muted"></small>
      <label class="wa-lean-check"><input id="beta3CatalogReplace" type="checkbox"> <span data-i18n="Ganti semua (hapus katalog lama)">Ganti semua (hapus katalog lama)</span></label>
      <div class="actions"><button class="button" type="submit" data-i18n="Impor">Impor</button></div>
    </form>
  </dialog>

  <section class="wa-lean-card wa-ai-examples">
    <div class="wa-lean-card-head">
      <div><h2 class="wa-card-eyebrow" data-i18n="Contoh jawaban CS">Contoh jawaban CS</h2><span id="beta3ExampleCount" class="wa-card-count"></span></div>
      <div class="actions"><button id="beta3ExampleOpen" class="wa-mini" type="button" aria-label="Tambah contoh" title="Tambah contoh" data-i18n-aria-label="Tambah contoh" data-i18n-title="Tambah contoh"><svg class="wa-ico" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg></button></div>
    </div>
    <label class="wa-search-field"><svg class="wa-ico" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><circle cx="11" cy="11" r="6" /><path d="m20 20-4.5-4.5" /></svg><input id="beta3ExampleSearch" type="search" placeholder="Cari contoh" data-i18n-placeholder="Cari contoh" aria-label="Cari contoh" data-i18n-aria-label="Cari contoh"></label>
    <div class="wa-order-table-scroll" tabindex="0" role="region" aria-label="Contoh jawaban CS" data-i18n-aria-label="Contoh jawaban CS">
      <table class="wa-order-table wa-lean-example-table">
        <thead><tr><th scope="col" data-i18n="Situasi">Situasi</th><th scope="col" data-i18n="Pesan pelanggan">Pesan pelanggan</th><th scope="col" data-i18n="Jawaban CS">Jawaban CS</th><th scope="col" data-i18n="Sumber">Sumber</th><th scope="col"><span class="wa-sr" data-i18n="Aksi">Aksi</span></th></tr></thead>
        <tbody id="beta3ExampleList"><tr><td colspan="5"><div class="wa-loading" data-i18n="Memuat…">Memuat…</div></td></tr></tbody>
      </table>
    </div>
  </section>
  </div>

  <dialog id="beta3ExampleDialog" class="wa-order-routing" aria-labelledby="beta3ExampleTitle">
    <header class="wa-order-routing-header"><strong id="beta3ExampleTitle" data-i18n="Tambah contoh">Tambah contoh</strong><button id="beta3ExampleClose" class="shell-icon-button" type="button" aria-label="Tutup" data-i18n-aria-label="Tutup" autofocus>×</button></header>
    <form id="beta3ExampleForm" class="wa-order-fields">
      <label><span data-i18n="Pesan pelanggan">Pesan pelanggan</span><textarea id="beta3ExampleCustomer" rows="2" required></textarea></label>
      <label><span data-i18n="Jawaban CS">Jawaban CS</span><textarea id="beta3ExampleCs" rows="2" required></textarea></label>
      <label><span data-i18n="Situasi (opsional)">Situasi (opsional)</span><input id="beta3ExampleSituation" type="text" maxlength="255" placeholder="pelanggan tanya cara ukur" data-i18n-placeholder="pelanggan tanya cara ukur"></label>
      <label><span data-i18n="Tag (koma; boleh tahap: tanya_size, minta_alamat, tunggu_bayar)">Tag (koma; boleh tahap: tanya_size, minta_alamat, tunggu_bayar)</span><input id="beta3ExampleTags" type="text" maxlength="255"></label>
      <div class="actions"><button class="button" type="submit" data-i18n="Simpan contoh">Simpan contoh</button></div>
    </form>
  </dialog>
</section>
