<label for="uiTheme">
  <span data-i18n="Tema tampilan">Tema tampilan</span>
  <select id="uiTheme">
    <option value="auto" selected data-i18n="Auto — mengikuti sistem">Auto — mengikuti sistem</option>
    <option value="light" data-i18n="Terang">Terang</option>
    <option value="dark" data-i18n="Gelap">Gelap</option>
  </select>
</label>
