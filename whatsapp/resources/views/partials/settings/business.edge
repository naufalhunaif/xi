<div class="wa-section-actions">
  <button id="mcpAddOpen" class="button primary" type="button" data-i18n="Tambah sumber">Tambah sumber</button>
</div>
<dialog id="mcpDialog" class="wa-settings-dialog" aria-labelledby="mcpDialogTitle">
  <header class="wa-settings-dialog-head"><strong id="mcpDialogTitle" data-i18n="Sumber data (MCP)">Sumber data (MCP)</strong><button type="button" class="shell-icon-button" data-dialog-close aria-label="Tutup" data-i18n-aria-label="Tutup">×</button></header>
  <div class="wa-mcp-add">
    <label><span data-i18n="Nama">Nama</span><input id="mcpName" type="text" maxlength="120" placeholder="Nama" data-i18n-placeholder="Nama" /></label>
    <label><span>URL MCP</span><input id="mcpUrl" type="url" maxlength="1000" placeholder="https://…" /></label>
    <div class="actions"><button id="mcpAddButton" class="button primary" type="button" data-i18n="Tambah">Tambah</button></div>
  </div>
</dialog>
<div id="mcpConnections" class="wa-mcp-list">
  @each(connection in settings.mcpConnections)
    <div class="wa-mcp-row" data-mcp-row="{{ connection.slug }}">
      <div class="wa-mcp-source">
        <span>
          <strong>{{ connection.name }}</strong>
          <small
            data-mcp-status
            class="wa-connection-indicator {{ connection.authenticated ? 'connected' : '' }}"
            title="{{ connection.authenticated ? 'Terhubung' : 'Belum terhubung' }}"
          >
            {{
              connection.authenticated
                ? 'Terhubung'
                : connection.pending
                  ? 'Menunggu login'
                  : connection.error
                    ? 'Gagal'
                    : 'Belum terhubung'
            }}
          </small>
        </span>
      </div>
      <div class="wa-setting-actions">
        <button
          class="wa-setting-icon wa-icon-connect"
          type="button"
          title="Hubungkan {{ connection.name }}"
          aria-label="Hubungkan {{ connection.name }}"
          data-mcp-connect="{{ connection.slug }}"
          {{ connection.sharedAuthenticated ? 'hidden' : '' }}
         data-i18n="Hubungkan">
          Hubungkan
        </button>
        <a
          class="wa-mcp-login wa-setting-icon wa-icon-external"
          data-mcp-login
          title="Login {{ connection.name }}"
          aria-label="Login {{ connection.name }}"
          href="{{ connection.verificationUrl || '#' }}"
          target="_blank"
          rel="noopener"
          {{ connection.verificationUrl ? '' : 'hidden' }}
         data-i18n="Login">
          Login
        </a>
        <button
          class="wa-setting-icon wa-icon-delete"
          type="button"
          data-mcp-delete="{{ connection.slug }}"
          aria-label="Hapus {{ connection.name }}"
          title="Hapus {{ connection.name }}"
         data-i18n="Hapus">
          Hapus
        </button>
        <button
          type="button"
          class="wa-switch"
          role="switch"
          aria-label="Aktifkan {{ connection.name }}"
          aria-checked="{{ connection.enabled ? 'true' : 'false' }}"
          value="{{ connection.enabled ? 'true' : 'false' }}"
          data-mcp-enabled="{{ connection.slug }}"
        ></button>
      </div>
    </div>
  @end
</div>
<div class="wa-card wa-policy-card" id="policyCard">
  <div class="wa-card-head">
    <div class="wa-card-title">
      <strong data-i18n="Kebijakan tukar size">Kebijakan tukar size</strong>
      <small data-i18n="Dibacakan AI saat pelanggan bertanya">Dibacakan AI saat pelanggan bertanya</small>
    </div>
  </div>
  <div class="wa-policy-box">
    <textarea id="policyText" rows="11" maxlength="2000" data-settings-ignore aria-label="Kebijakan tukar size" data-i18n-aria-label="Kebijakan tukar size" disabled></textarea>
    <div id="policyLoading" class="wa-loading" data-i18n="Memuat…">Memuat…</div>
  </div>
  <div class="wa-policy-foot">
    <small id="policyStatus" class="wa-muted" role="status" aria-live="polite"></small>
    <button id="policyCopy" class="button" type="button" data-i18n="Salin">Salin</button>
    <button id="policySave" class="button primary" type="button" disabled data-i18n="Simpan">Simpan</button>
  </div>
</div>
