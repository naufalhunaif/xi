# Node
TZ=Asia/Jakarta
PORT=3333
HOST=127.0.0.1
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
# Standalone (dipasang di akar domain): APP_URL=https://wa.domainku.com, APP_BASE_PATH kosong,
# ACCOUNT_URL kosong -> login lokal (email + password, tabel wa_users).
APP_URL=http://localhost/alogaritm--app/whatsapp
APP_BASE_PATH=/alogaritm--app/whatsapp
# Bundle (bersama Store/Material/Invoice/Fit): isi ACCOUNT_URL -> login OAuth Account.
ACCOUNT_URL=http://localhost/alogaritm--app/account
# AUTH_MODE=local|oauth (opsional; default mengikuti ACCOUNT_URL kosong/terisi)
CODEX_BIN=codex
CLAUDE_BIN=claude
# HTTPS MCP callback listener: block inbound access to this port in the server firewall.
# Nginx must send /whatsapp/oauth/mcp/callback/ to the WEB process (3333), never directly here.
MCP_OAUTH_CALLBACK_PORT=3334

# Session
SESSION_DRIVER=cookie

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=whatsapp
